# Copy to .env and adjust. `make env` does this and fills DJANGO_SECRET_KEY for local dev.
# In docker compose, database/redis/secret-key secrets are generated automatically on first
# start; you only need the non-secret settings below.

# ---- Docker / public URL
DOMAIN=localhost
# HTTP_PORT=80
# HTTPS_PORT=443

# ---- Local development only (manage.py runserver)
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
# DATABASE_URL=postgres://user:password@localhost:5432/threatledger   # default: SQLite
# REDIS_URL=redis://localhost:6379/0                                  # default: in-memory cache, ORM job broker

# ---- Optional
# TIME_ZONE=UTC
# LOG_LEVEL=INFO
# AUDIT_IP_MODE=full            # or "truncated" for privacy-sensitive deployments
# SESSION_COOKIE_AGE=28800      # seconds
# GUNICORN_WORKERS=3
# Q_WORKERS=2

# ---- Email (review reminders, expiry alerts)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=threatledger@example.com

# ---- Demo seed: shared password for seeded users (otherwise random, printed once)
# SEED_PASSWORD=
